---
permalink: feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>Nasc Consulting — Insights</title>
  <link>https://nascconsulting.com/insights/</link>
  <description>White papers, project notes, and updates from Nasc Consulting.</description>
  <language>en-us</language>
  <atom:link href="https://nascconsulting.com/feed.xml" rel="self" type="application/rss+xml" />
  {% for item in collections.insights %}
  <item>
    <title>{{ item.data.title }}</title>
    <link>https://nascconsulting.com{{ item.url }}</link>
    <guid>https://nascconsulting.com{{ item.url }}</guid>
    <pubDate>{{ item.data.date | rssDate }}</pubDate>
    <description>{{ item.data.summary }}</description>
  </item>
  {% endfor %}
</channel>
</rss>
